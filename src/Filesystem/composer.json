{
    "name": "laraxgram/filesystem",
    "description": "The LaraGram Filesystem package.",
    "license": "MIT",
    "authors": [
        {
            "name": "laraXgram",
            "email": "laraxgram@gmail.com"
        }
    ],
    "homepage": "https://laraxgram.github.io",
    "support": {
        "issues": "https://github.com/laraxgram/core/issues",
        "source": "https://github.com/laraxgram/core"
    },
    "require": {
        "php": "^8.3",
        "laraxgram/collections": "^4.0",
        "laraxgram/conditionable": "^4.0",
        "laraxgram/contracts": "^4.0",
        "laraxgram/macroable": "^4.0",
        "laraxgram/support": "^4.0"
    },
    "suggest": {
        "ext-fileinfo": "Required to use the Filesystem class.",
        "ext-ftp": "Required to use the Flysystem FTP driver.",
        "ext-hash": "Required to use the Filesystem class.",
        "laraxgram/container": "Required to use the S3 driver (^4.0).",
        "laraxgram/http": "Required for handling uploaded files and to use the S3 driver (^4.0).",
        "laraxgram/image": "Required to store images (^4.0).",
        "league/flysystem-sftp-v3": "Required to use the Flysystem SFTP driver (^3.25.1)."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "LaraGram\\Filesystem\\": ""
        },
        "files": [
            "functions.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
