{
    "name": "laraxgram/routing",
    "description": "The LaraGram Routing package.",
    "license": "MIT",
    "authors": [
        {
            "name": "laraXgram",
            "email": "laraxgram@gmail.com"
        }
    ],
    "homepage": "https://laraxgram.github.io",
    "support": {
        "issues": "https://github.com/laraxgram/core/issues",
        "source": "https://github.com/laraxgram/core"
    },
    "require": {
        "php": "^8.3",
        "ext-filter": "*",
        "ext-hash": "*",
        "laraxgram/collections": "^4.0",
        "laraxgram/conditionable": "^4.0",
        "laraxgram/container": "^4.0",
        "laraxgram/contracts": "^4.0",
        "laraxgram/http": "^4.0",
        "laraxgram/macroable": "^4.0",
        "laraxgram/pipeline": "^4.0",
        "laraxgram/reflection": "^4.0",
        "laraxgram/session": "^4.0",
        "laraxgram/support": "^4.0"
    },
    "suggest": {
        "laraxgram/console": "Required to use the make commands (^4.0).",
        "laraxgram/listening": "Required to use expression based route conditions (^4.0)."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "LaraGram\\Routing\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
