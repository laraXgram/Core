{
    "name": "laraxgram/http",
    "description": "The LaraGram Http package.",
    "license": "MIT",
    "authors": [
        {
            "name": "laraXgram",
            "email": "laraxgram@gmail.com"
        }
    ],
    "homepage": "https://laraxgram.github.io",
    "support": {
        "issues": "https://github.com/laraxgram/core/issues",
        "source": "https://github.com/laraxgram/core"
    },
    "require": {
        "php": "^8.3",
        "ext-filter": "*",
        "laraxgram/collections": "^4.0",
        "laraxgram/conditionable": "^4.0",
        "laraxgram/contracts": "^4.0",
        "laraxgram/cookie": "^4.0",
        "laraxgram/filesystem": "^4.0",
        "laraxgram/macroable": "^4.0",
        "laraxgram/session": "^4.0",
        "laraxgram/support": "^4.0"
    },
    "suggest": {
        "ext-gd": "Required to use LaraGram\\Http\\Testing\\FileFactory::image().",
        "laraxgram/database": "Required to use the JSON API resources of Eloquent models (^4.0).",
        "laraxgram/image": "Required to use the image methods of uploaded files (^4.0).",
        "laraxgram/pagination": "Required to use paginated resource collections (^4.0)."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "LaraGram\\Http\\": ""
        },
        "files": [
            "VarDumper/functions.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
