    "license": "MIT",
    "authors": [
        {
            "name": "laraXgram",
            "email": "laraxgram@gmail.com"
        }
    ],
    "homepage": "https://laraxgram.github.io",
    "support": {
        "issues": "https://github.com/laraxgram/core/issues",
        "source": "https://github.com/laraxgram/core"
    },
    "require": {
        "php": "^8.3",
        "laraxgram/collections": "^4.0",
        "laraxgram/contracts": "^4.0",
        "laraxgram/macroable": "^4.0",
        "laraxgram/support": "^4.0"
    },
    "suggest": {
        "ext-redis": "Required to use the phpredis connector (^4.0 || ^5.0 || ^6.0).",
        "predis/predis": "Required to use the predis connector (^2.3 || ^3.0)."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "LaraGram\\Redis\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
